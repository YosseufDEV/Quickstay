// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
    USER
    ADMIN
}

model User {
    id  String @id @default(uuid()) @db.Uuid
    firstName String @map("first_name")
    lastName String @map("last_name")
    email String @unique
    country String
    password String 
    booking HotelBooking[]
    role Role @default(USER)
}

model Hotel {
    id String @id @default(uuid()) @db.Uuid
    rating Float
    name String
    exactAddress String @map("exact_address")
    address String
    pricePerNight Int @map("price_per_night")
    imageUrl String @map("image_url")
    createdAt DateTime @default(now()) @map("created_at")
    tags Tag[]
    bookings HotelBooking[]
    @@index([createdAt])
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
}

enum CheckInStatus {
    NOT_CHECKED_IN
    CHECKED_IN
    CHECKED_OUT
}

model HotelBooking {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    hotelId String @map("hotel_id") @db.Uuid
    userId String @map("user_id") @db.Uuid
    fromTo Unsupported("tsrange") @map("from_to")
    createdAt DateTime @default(now()) @map("created_at")
    bookingStatus BookingStatus @default(PENDING) @map("booking_status")
    checkInStatus CheckInStatus @default(NOT_CHECKED_IN) @map("check_in_status")

    @@index([hotelId])
    @@index([userId])
}

model Tag {
    id Int @id @default(autoincrement())
    name String @unique
    slag String @unique
    hotels Hotel[]
}

model HotelTag {
    hotelId String @db.Uuid
    tagId String
    @@id([hotelId, tagId])
}
