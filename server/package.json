    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "pg": "^8.22.0",
    "random-weighted-choice": "^0.1.4",
    "redis": "^6.2.0",
    "stripe": "^22.4.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
