  "main": "server.ts",
  "scripts": {
    "dev": "docker-compose up -d && concurrently \"tsx watch src/server.ts\" \"stripe listen --forward-to localhost:5050/api/v1/webhook\" ",
    "test": "vitest run --silent",
    "seed": "tsx ./src/seed/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit generate && drizzle-kit migrate",
    "db:setup": "tsx ./migrate.ts",
    "confirm:payment": "stripe payment_intents confirm $1 -d payment_method=pm_card_visa"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
